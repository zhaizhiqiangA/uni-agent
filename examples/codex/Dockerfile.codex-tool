# Codex sidecar tool image.
#
# The image contains a portable Python runtime for the recipe-local protocol
# bridge plus the native CLI resources from the npm package. It is mounted at
# /opt/codex in the task sandbox.
FROM node:22-bookworm-slim AS builder

ARG CODEX_VERSION="0.147.0"
ARG PBS_RELEASE="20260602"
ARG PBS_PYTHON="3.12.13"
ARG NPM_REGISTRY=""
ENV npm_config_audit=false npm_config_fund=false npm_config_update_notifier=false

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates wget \
    && rm -rf /var/lib/apt/lists/* \
    && wget -q \
        "https://github.com/astral-sh/python-build-standalone/releases/download/${PBS_RELEASE}/cpython-${PBS_PYTHON}%2B${PBS_RELEASE}-x86_64-unknown-linux-gnu-install_only_stripped.tar.gz" \
        -O /tmp/python.tar.gz \
    && mkdir -p /opt/codex \
    && tar -xzf /tmp/python.tar.gz -C /opt/codex --strip-components=1 \
    && rm /tmp/python.tar.gz \
    && if [ -n "${NPM_REGISTRY}" ]; then npm config set registry "${NPM_REGISTRY}"; fi \
    && mkdir -p /tmp/codex-package \
    && npm install --prefix /tmp/codex-package --no-save --no-package-lock --include=optional \
        "@openai/codex@${CODEX_VERSION}" \
    && vendor_root="$(find /tmp/codex-package/node_modules -type d -path '*/@openai/codex-linux-x64/vendor/x86_64-unknown-linux-musl' -print -quit)" \
    && test -n "${vendor_root}" \
    && mkdir -p /opt/codex/vendor/x86_64-unknown-linux-musl /opt/codex/bin \
    && cp -a "${vendor_root}/." /opt/codex/vendor/x86_64-unknown-linux-musl/ \
    && /opt/codex/vendor/x86_64-unknown-linux-musl/bin/codex --version

COPY codex-wrapper.sh /opt/codex/bin/codex
COPY run_agent.sh /opt/codex/bin/run_agent.sh
COPY responses_proxy.py /opt/codex/bin/responses_proxy.py
RUN chmod 0755 /opt/codex/bin/codex /opt/codex/bin/run_agent.sh /opt/codex/bin/responses_proxy.py

FROM scratch
COPY --from=builder /opt/codex /
